@model SportMatrix.Frontend.Models.AthleteListViewModel
@{
    ViewData["Title"] = "Athletes";

    // Avatar colour variant based on first char of last name
    Func<string, int> avatarVariant = name =>
        string.IsNullOrEmpty(name) ? 0 : (int)(name[0]) % 6;
}

<div class="page-header">
    <div>
        <h1>Athletes</h1>
        <p>Manage your athlete roster and view individual dashboards.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-orange btn-xl">
            <i class="bi bi-person-plus-fill"></i> Add Athlete
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@Model.Error</span>
    </div>
}

@if (Model.Loading)
{
    <div class="loading-state">
        <div class="spinner spinner-lg"></div>
        <span>Loading athletes…</span>
    </div>
}
else if (Model.Athletes.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h3>No athletes yet</h3>
        <p>Add your first athlete to get started with performance tracking.</p>
        <a asp-action="Create" class="btn btn-orange btn-xl" style="margin-top:8px;">
            <i class="bi bi-person-plus-fill"></i> Add Athlete
        </a>
    </div>
}
else
{
    <div class="athlete-list">
        @foreach (var athlete in Model.Athletes)
        {
            var fn = athlete.FirstName ?? "";
            var ln = athlete.LastName ?? "";
            var initials = $"{(fn.Length > 0 ? fn[..1] : "")}{(ln.Length > 0 ? ln[..1] : "?")}".ToUpper();
            var colorIdx = avatarVariant(ln.Length > 0 ? ln : fn.Length > 0 ? fn : "A");

            <div class="athlete-list-item">
                <a asp-action="Details" asp-route-id="@athlete.Id" class="athlete-list-link">
                    <div class="athlete-list-avatar">
                        <div class="avatar avatar-md av-@colorIdx">@initials</div>
                    </div>

                    <div class="athlete-list-info">
                        <div class="athlete-list-name">@athlete.FirstName @athlete.LastName</div>
                        <div class="athlete-list-email">@athlete.Email</div>
                    </div>

                    <div class="athlete-list-stats">
                        <div class="athlete-stat-mini">
                            <span class="val">@athlete.Weight</span><span class="unit">kg</span>
                        </div>
                        <div class="athlete-stat-mini">
                            <span class="val">@athlete.Height</span><span class="unit">cm</span>
                        </div>
                        <div class="athlete-stat-mini">
                            <span class="val">@athlete.DateOfBirth.ToString("yyyy")</span><span class="unit">born</span>
                        </div>
                    </div>
                </a>

                <div class="athlete-list-actions">
                    <a asp-controller="Dashboard" asp-action="Index" asp-route-id="@athlete.Id"
                       class="btn btn-mint btn-sm" title="Open Dashboard">
                        <i class="bi bi-speedometer2"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@athlete.Id"
                       class="btn btn-ghost btn-sm" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" asp-action="Delete" asp-route-id="@athlete.Id" class="d-inline"
                          onsubmit="return confirm('Delete @athlete.FirstName @athlete.LastName? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-icon is-danger" title="Delete">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="pagination-info">
                Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalAthletes) of @Model.TotalAthletes athletes
            </div>
            <div class="pagination-actions">
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                   class="page-btn @(!Model.HasPreviousPage ? "disabled" : "")"
                   onclick="@(!Model.HasPreviousPage ? "return false;" : null)">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                   class="page-btn @(!Model.HasNextPage ? "disabled" : "")"
                   onclick="@(!Model.HasNextPage ? "return false;" : null)">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    }
}
