@model FitnessAnalyticsHub.Frontend.Models.AthleteListViewModel
@{
    ViewData["Title"] = "Athleten Übersicht";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Athleten Übersicht</h2>
        <div>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Neuer Athlet
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Error != null)
    {
        <div class="alert alert-danger">
            @Model.Error
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.Loading)
            {
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Wird geladen...</span>
                    </div>
                </div>
            }
            else if (Model.Athletes.Count == 0)
            {
                <div class="text-center p-4">
                    <p>Keine Athleten gefunden.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>E-Mail</th>
                                <th>Geburtsdatum</th>
                                <th>Gewicht (kg)</th>
                                <th>Größe (cm)</th>
                                <th>Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var athlete in Model.Athletes)
                            {
                                <tr>
                                    <td>@athlete.Id</td>
                                    <td>@athlete.FirstName @athlete.LastName</td>
                                    <td>@athlete.Email</td>
                                    <td>@athlete.DateOfBirth.ToString("dd.MM.yyyy")</td>
                                    <td>@athlete.Weight</td>
                                    <td>@athlete.Height</td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-sm btn-info me-1">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@athlete.Id" class="btn btn-sm btn-primary me-1">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-action="Delete" asp-route-id="@athlete.Id" class="d-inline" onsubmit="return confirm('Bist du sicher, dass du diesen Athleten löschen möchtest?');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
