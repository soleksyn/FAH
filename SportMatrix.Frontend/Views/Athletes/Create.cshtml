@model SportMatrix.Frontend.Models.AthleteCreateViewModel
@{
    ViewData["Title"] = "Add Athlete";
}

<div class="page-header">
    <div>
        <h1>Add Athlete</h1>
        <p>Create a new athlete profile to start tracking performance.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-ghost">
            <i class="bi bi-arrow-left"></i> Back to Athletes
        </a>
    </div>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@Model.Error</span>
    </div>
}

<div class="form-card form-card-narrow">
    <form method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

        <div class="form-section">
            <div class="form-section-title">Identity</div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FirstName" class="form-label">First Name <span class="required">*</span></label>
                    <input asp-for="FirstName" class="form-control" placeholder="e.g. Olena" autocomplete="given-name" />
                    <div asp-validation-for="FirstName" class="form-error"></div>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="form-label">Last Name <span class="required">*</span></label>
                    <input asp-for="LastName" class="form-control" placeholder="e.g. Kovalenko" autocomplete="family-name" />
                    <div asp-validation-for="LastName" class="form-error"></div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="e.g. athlete@sportmatrix.ua" autocomplete="email" />
                <div asp-validation-for="Email" class="form-error"></div>
            </div>

            <div class="form-group">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="required">*</span></label>
                <input asp-for="DateOfBirth" type="date" class="form-control"
                       min="1920-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <div asp-validation-for="DateOfBirth" class="form-error"></div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Body Metrics</div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Weight" class="form-label">Weight (kg) <span class="required">*</span></label>
                    <input asp-for="Weight" type="number" step="0.1" min="20" max="300" class="form-control" placeholder="e.g. 72.5" />
                    <div asp-validation-for="Weight" class="form-error"></div>
                </div>
                <div class="form-group">
                    <label asp-for="Height" class="form-label">Height (cm) <span class="required">*</span></label>
                    <input asp-for="Height" type="number" step="0.1" min="100" max="250" class="form-control" placeholder="e.g. 178" />
                    <div asp-validation-for="Height" class="form-error"></div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn btn-orange">
                <i class="bi bi-person-plus-fill"></i>
                Save Athlete
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
