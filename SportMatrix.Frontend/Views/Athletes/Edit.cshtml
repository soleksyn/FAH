@model SportMatrix.Frontend.Models.AthleteEditViewModel
@{
    ViewData["Title"] = "Edit Athlete";
}

<div class="page-header">
    <div>
        <h1>Edit Athlete</h1>
        <p>Update the athlete's personal information and body metrics.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@Model.Error</span>
    </div>
}

@if (Model.Loading)
{
    <div class="loading-state">
        <div class="spinner spinner-lg"></div>
        <span>Loading athlete…</span>
    </div>
}
else
{
    <div class="form-card form-card-narrow">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-section">
                <div class="form-section-title">Identity</div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FirstName" class="form-label">First Name <span class="required">*</span></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Anna" />
                        <div asp-validation-for="FirstName" class="form-error"></div>
                    </div>
                    <div class="form-group">
                        <label asp-for="LastName" class="form-label">Last Name <span class="required">*</span></label>
                        <input asp-for="LastName" class="form-control" placeholder="Schmidt" />
                        <div asp-validation-for="LastName" class="form-error"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email <span class="required">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="anna@example.com" />
                    <div asp-validation-for="Email" class="form-error"></div>
                </div>

                <div class="form-group">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="required">*</span></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <div asp-validation-for="DateOfBirth" class="form-error"></div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Body Metrics</div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Weight" class="form-label">Weight (kg) <span class="required">*</span></label>
                        <input asp-for="Weight" type="number" step="0.1" min="20" max="300" class="form-control" />
                        <div asp-validation-for="Weight" class="form-error"></div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Height" class="form-label">Height (cm) <span class="required">*</span></label>
                        <input asp-for="Height" type="number" step="0.1" min="100" max="250" class="form-control" />
                        <div asp-validation-for="Height" class="form-error"></div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-orange" disabled="@(Model.Submitting ? "disabled" : null)">
                    @if (Model.Submitting)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <i class="bi bi-check2"></i>
                    }
                    Save Changes
                </button>
            </div>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
