@model SportMatrix.Frontend.Models.AthleteListViewModel
@{
    ViewData["Title"] = "Athletes";

    // Avatar colour variant based on first char of last name
    Func<string, int> avatarVariant = name =>
        string.IsNullOrEmpty(name) ? 0 : (int)(name[0]) % 6;
}

<div class="page-header">
    <div>
        <h1>Athletes</h1>
        <p>Manage your athlete roster and view individual dashboards.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-orange">
            <i class="bi bi-person-plus-fill"></i> Add Athlete
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@Model.Error</span>
    </div>
}

@if (Model.Loading)
{
    <div class="loading-state">
        <div class="spinner spinner-lg"></div>
        <span>Loading athletes…</span>
    </div>
}
else if (Model.Athletes.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h3>No athletes yet</h3>
        <p>Add your first athlete to get started with performance tracking.</p>
        <a asp-action="Create" class="btn btn-orange" style="margin-top:8px;">
            <i class="bi bi-person-plus-fill"></i> Add Athlete
        </a>
    </div>
}
else
{
    <div class="athlete-grid">
        @foreach (var athlete in Model.Athletes)
        {
            var initials  = $"{athlete.FirstName?[..1]}{athlete.LastName?[..1]}".ToUpper();
            var colorIdx  = avatarVariant(athlete.LastName ?? athlete.FirstName ?? "A");

            <div class="athlete-card">
                <div class="athlete-card-avatar">
                    <div class="avatar avatar-lg av-@colorIdx">@initials</div>
                </div>

                <div class="athlete-card-name">@athlete.FirstName @athlete.LastName</div>
                <div class="athlete-card-email">@athlete.Email</div>

                <div class="athlete-card-stats">
                    <div class="athlete-stat-chip">
                        <span>@athlete.Weight</span>
                        <span>kg</span>
                    </div>
                    <div class="athlete-stat-chip">
                        <span>@athlete.Height</span>
                        <span>cm</span>
                    </div>
                    <div class="athlete-stat-chip">
                        <span>@athlete.DateOfBirth.ToString("yyyy")</span>
                        <span>born</span>
                    </div>
                </div>

                <div class="athlete-card-actions">
                    <a asp-action="Details" asp-route-id="@athlete.Id"
                       class="btn btn-ghost btn-sm" title="View Details">
                        <i class="bi bi-eye"></i> View
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" asp-route-id="@athlete.Id"
                       class="btn btn-mint btn-sm" title="Open Dashboard">
                        <i class="bi bi-speedometer2"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@athlete.Id"
                       class="btn btn-ghost btn-sm" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" asp-action="Delete" asp-route-id="@athlete.Id" class="d-inline"
                          onsubmit="return confirm('Delete @athlete.FirstName @athlete.LastName? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-icon is-danger" title="Delete">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
