@model SportMatrix.Frontend.Models.Auth.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — SportMatrix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css"     asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css"       asp-append-version="true" />
</head>
<body>
<div class="auth-page">
    <div class="auth-card">

        <!-- Brand -->
        <div class="auth-logo">
            <img src="~/images/logo.png" alt="SportMatrix Logo" />
            <div class="auth-logo-text">
                <span class="auth-logo-name">SportMatrix</span>
                <span class="auth-logo-sub">Analytics Hub</span>
            </div>
        </div>

        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Sign in to your admin account</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-validation-summary">
                @Html.ValidationSummary(false, null, new { @class = "" })
            </div>
        }

        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="auth-form-group">
                <label class="auth-label" asp-for="Email">Email</label>
                <input class="auth-input" asp-for="Email" type="email" autocomplete="email" placeholder="admin@sportmatrix.com" />
                <span class="auth-field-error" asp-validation-for="Email"></span>
            </div>

            <div class="auth-form-group">
                <label class="auth-label" asp-for="Password">Password</label>
                <input class="auth-input" asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••" />
                <span class="auth-field-error" asp-validation-for="Password"></span>
            </div>

            <div class="auth-remember">
                <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                <label for="rememberMe">Remember me</label>
            </div>

            <button type="submit" class="auth-btn">
                <i class="bi bi-box-arrow-in-right" style="margin-right:.4rem;"></i>
                Sign In
            </button>
        </form>

        <div class="auth-footer">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Create one</a>
        </div>

    </div>
</div>
</body>
</html>
