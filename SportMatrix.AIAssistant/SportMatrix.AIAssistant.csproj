<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>1d01d35d-186b-4e05-be37-768500706931</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AssemblyName>SportMatrix.AIAssistant</AssemblyName>
    <RootNamespace>SportMatrix.AIAssistant</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\common.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\motivation.proto" GrpcServices="Both" ProtoRoot="Protos">
      <Access>Public</Access>
    </Protobuf>
    <Protobuf Include="Protos\workout.proto" GrpcServices="Both" ProtoRoot="Protos">
      <Access>Public</Access>
    </Protobuf>
  </ItemGroup>

</Project>
